# 6thAgent — Environment Variables
# ==============================================
# Two completely free options — no config needed to start:
# Option A: Ollama (local) — zero setup, runs on your machine
# Option B: Gemini (cloud) — free tier API key
# ==============================================

# === Supabase (required) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI Provider: Ollama (FREE — local, no API key needed) ===
# Install: curl -fsSL https://ollama.com/install.sh | bash
# Pull: ollama pull llama3.2
# Run: ollama serve
# No env vars needed — works out of the box at localhost:11434
# ⚠️ Slower than cloud (~5-20 tok/s) but completely free and private

# === AI Provider: Gemini (FREE TIER — cloud, faster) ===
# Get key: https://aistudio.google.com/apikey
# Free: 60 requests/min, 1500 requests/day on Gemini 2.5 Flash
GEMINI_API_KEY=
# ⚡ Fast inference (~50-100 tok/s)

# === AI Provider: OpenAI (PAID — cloud, fastest) ===
OPENAI_API_KEY=

# === Stripe (for billing — optional in dev) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CORE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=6thAgent

# === Credit Monitoring ===
GEMINI_LOW_CREDIT_THRESHOLD=2.00
GEMINI_AUTO_RELOAD_AMOUNT=20.00
CREDIT_ALERT_EMAIL=admin@6thagent.ai

# === Cron ===
CRON_SECRET=your-cron-secret

# === Tier Defaults ===
FREE_TIER_PROVIDER=ollama
PAID_TIER_PROVIDER=gemini

# === Feature Flags ===
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true
