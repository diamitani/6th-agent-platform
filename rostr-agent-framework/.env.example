# Rostr Framework Configuration

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional: for embeddings

# Hub Configuration
ROSTR_WORKSPACE_PATH=./rostr-data
ROSTR_DEFAULT_MODEL=claude-sonnet-4-6
ROSTR_FAST_MODEL=claude-haiku-4-5

# RAG DAL Configuration
RAGDAL_CONFIDENCE_THRESHOLD=0.8
RAGDAL_MAX_PASSES=3
RAGDAL_MAX_SOURCES=25

# NPAO Configuration
NPAO_PHASE_URGENCY_WEIGHT=0.35
NPAO_DEPENDENCY_IMPACT_WEIGHT=0.30
NPAO_BUSINESS_IMPACT_WEIGHT=0.25
NPAO_RESOURCE_EFFICIENCY_WEIGHT=0.10

# Optional: Vector Storage (Supabase)
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_key

# Optional: Redis Cache
# REDIS_URL=redis://localhost:6379

# Optional: Web Search
# SERPAPI_KEY=your_serpapi_key  # For web search in RAG DAL

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # or "text"
