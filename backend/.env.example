# 6th Agent Backend Configuration

# Environment
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/6th_agent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Ollama (LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_FAST_MODEL=deepseek-r1:7b
OLLAMA_REASONING_MODEL=deepseek-r1:32b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600  # 100MB
ALLOWED_EXTENSIONS=pdf,docx,txt,md,py,js,ts,java,go,rs,csv,json,yaml,zip

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=6th-agent
MINIO_SECURE=false

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# RAG DAL Configuration
RAGDAL_ENABLED=true
RAGDAL_CONFIDENCE_THRESHOLD=8
RAGDAL_MAX_PASSES=3
RAGDAL_CACHE_TTL_HOURS=72

# NPAO Configuration
NPAO_ENABLED=true
NPAO_MAX_PARALLEL_TASKS=5
NPAO_TASK_TIMEOUT_MINUTES=60

# Integrations
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ──────────────────────────────────────────────
# Multi-Channel Integration (WhatsApp, Signal, Teams, Slack)
# ──────────────────────────────────────────────

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=6th-agent-webhook-verify

# Signal (via signal-cli REST API)
SIGNAL_CLI_URL=http://localhost:8080
SIGNAL_PHONE_NUMBER=

# Slack (Events API + Bot Token)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-...

# Microsoft Teams (Graph API)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Cloud Provider Integration (Azure, Oracle, AWS)
# ──────────────────────────────────────────────

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Oracle Cloud (OCI)
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_REGION=us-ashburn-1
OCI_KEY_FILE=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
